{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "ALYA Companion",
    "version":  "1.0.0-rc.12",
    "identifier":  "com.alya.companion",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://localhost:1420",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "ALYA Companion",
                                    "width":  1180,
                                    "height":  760,
                                    "minWidth":  900,
                                    "minHeight":  620,
                                    "center":  true,
                                    "resizable":  true
                                }
                            ],
                "security":  {
                                 "csp":  "default-src \u0027self\u0027; img-src \u0027self\u0027 asset: data: https://raw.githubusercontent.com https://*.supabase.co https://cdn.discordapp.com https://media.discordapp.net https://images-ext-1.discordapp.net; style-src \u0027self\u0027 \u0027unsafe-inline\u0027; connect-src \u0027self\u0027 ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co"
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "createUpdaterArtifacts":  true,
                   "category":  "Utility",
                   "shortDescription":  "ALYA Companion for AlyArchetype, Surf patches and vanity previews",
                   "longDescription":  "Manage AlyArchetype, Surf ROM patches, vanity previews, roaming rotations, Shinyboard, the PokeMMO forum and ALYA Companion updates without controlling the PokeMMO client.",
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico"
                            ],
                   "resources":  [
                                     "resources/surf/*",
                                     "licenses/*",
                                     "resources/mods-bundled/**/*"
                                 ],
                   "externalBin":  [
                                       "binaries/xdelta3"
                                   ]
               },
    "plugins":  {
                    "updater":  {
                                    "pubkey":  "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNENDRkZGQzhCMEU0ODAKUldTQTVMREkvODlNdytIQjVQRnNVeFJEbXE2R3ZlR2g2MG0vbnM1SU03czVnRWsrSm9GMC9tUCsK",
                                    "endpoints":  [
                                                      "https://github.com/Jimbowiii/Alya-Companion/releases/download/updater-metadata/latest.json"
                                                  ],
                                    "windows":  {
                                                    "installMode":  "passive"
                                                }
                                },
                    "deep-link":  {
                                      "desktop":  {
                                                      "schemes":  [
                                                                      "alya-companion"
                                                                  ]
                                                  }
                                  }
                }
}
