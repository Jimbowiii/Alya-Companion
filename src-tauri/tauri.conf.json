{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alya Companion",
  "version": "1.0.0-rc.9",
  "identifier": "com.alya.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Alya Companion",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://raw.githubusercontent.com https://*.supabase.co; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co wss://*.supabase.co"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "category": "Utility",
    "shortDescription": "Alya Companion for AlyArchetype, Surf patches and vanity previews",
    "longDescription": "Manage AlyArchetype, Surf ROM patches, vanity previews, roaming rotations, Shinyboard, the PokeMMO forum and Alya Companion updates without controlling the PokeMMO client.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/surf/*",
      "licenses/*"
    ],
    "externalBin": [
      "binaries/xdelta3"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNENDRkZGQzhCMEU0ODAKUldTQTVMREkvODlNdytIQjVQRnNVeFJEbXE2R3ZlR2g2MG0vbnM1SU03czVnRWsrSm9GMC9tUCsK",
      "endpoints": [
        "https://github.com/Jimbowiii/Alya-Companion/releases/download/updater-metadata/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "alya-companion"
        ]
      }
    }
  }
}
