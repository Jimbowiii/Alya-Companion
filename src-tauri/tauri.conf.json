{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Alya Companion",
  "version": "1.0.0-rc.1",
  "identifier": "com.alya.companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Alya Companion",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "category": "Utility",
    "shortDescription": "Alya Companion for AlyArchetype, Surf patches and vanity previews",
    "longDescription": "Manage AlyArchetype releases, Surf ROM patches, vanity previews and Alya Companion updates without controlling the PokeMMO client.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/surf/*",
      "licenses/*"
    ],
    "externalBin": [
      "binaries/xdelta3"
    ]
  }
}
